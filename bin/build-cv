#!/usr/bin/env bash
#
# Build the CV PDF from resume.json + papers.bib via Typst.
#
# Usage:
#   ./bin/build-cv           # build once
#   ./bin/build-cv --watch   # rebuild on save (typst watch)
#
# Requires:
#   brew install typst
#   python3 -m pip install --user --break-system-packages bibtexparser

set -e
cd "$(dirname "$0")/.."

echo "→ Regenerating cv/papers.json from _bibliography/papers.bib"
python3 cv/build_papers.py

# build_papers.py also rewrites the publications list in resume.json; keep it
# in the repo's Prettier style so the CI format check stays green.
if command -v npx >/dev/null 2>&1 && [[ -x node_modules/.bin/prettier ]]; then
  npx prettier --write assets/json/resume.json --log-level warn
fi

OUT="assets/pdf/CV_Sandhaus.pdf"

if [[ "${1:-}" == "--watch" ]]; then
  echo "→ typst watch cv/cv.typ → $OUT"
  exec typst watch --root . cv/cv.typ "$OUT"
else
  echo "→ typst compile cv/cv.typ → $OUT"
  typst compile --root . cv/cv.typ "$OUT"
  echo "✓ Built $OUT ($(du -h "$OUT" | cut -f1))"
fi
